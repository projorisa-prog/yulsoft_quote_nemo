# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/quote_nemo
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/quote_nemo

# App
APP_NAME="율소프트 견적서"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="your-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://yulsoft.kr"]

# Rate Limiting
RATE_LIMIT_PREVIEW=30
RATE_LIMIT_CREATE=10
RATE_LIMIT_VIEW=60
RATE_LIMIT_PDF=20

# PDF
WATERMARK_TEXT="Powered by 율소프트 | www.yulsoft.kr"
PDF_FONT_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
PDF_FONT_BOLD_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"

# Expiration
DEFAULT_EXPIRES_DAYS=30
MAX_EXPIRES_DAYS=365

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend URL (for public URLs)
FRONTEND_URL=http://localhost:3000